  "repository": {
    "type": "git",
    "url": "https://github.com/Quoralinex/q1x-community-orchestrator.git",
    "directory": "packages/desktop-bridge-windows"
  },
  "homepage": "https://quoralinex.github.io/q1x-community-orchestrator/",
  "publishConfig": {
    "access": "public"
  }
