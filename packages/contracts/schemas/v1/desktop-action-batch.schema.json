{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:q1x:community:contracts:v1:desktop-action-batch",
  "title": "Desktop Action Batch",
  "type": "object",
  "required": [
    "contractVersion",
    "id",
    "actions"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "stopOnError": {
      "type": "boolean"
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 50,
      "maximum": 3600000
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "target": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "by",
            "applicationId"
          ],
          "properties": {
            "by": {
              "const": "application"
            },
            "applicationId": {
              "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "by",
            "x",
            "y"
          ],
          "properties": {
            "by": {
              "const": "coordinates"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "by"
          ],
          "properties": {
            "by": {
              "const": "window"
            },
            "applicationId": {
              "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier"
            },
            "title": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "by",
            "applicationId"
          ],
          "properties": {
            "by": {
              "const": "accessibility"
            },
            "applicationId": {
              "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier"
            },
            "role": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "identifier": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "action": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "launch",
            "activate",
            "quit",
            "inspect",
            "click",
            "double-click",
            "mouse-move",
            "mouse-down",
            "mouse-up",
            "wheel",
            "drag",
            "type",
            "press",
            "hotkey",
            "wait",
            "screenshot"
          ]
        },
        "applicationId": {
          "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "source": {
          "$ref": "#/$defs/target"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "deltaX": {
          "type": "number"
        },
        "deltaY": {
          "type": "number"
        },
        "button": {
          "enum": [
            "left",
            "middle",
            "right"
          ]
        },
        "text": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "milliseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "outputPath": {
          "type": "string",
          "minLength": 1
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 50,
          "maximum": 3600000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "launch"
              }
            }
          },
          "then": {
            "required": [
              "applicationId"
            ],
            "properties": {
              "applicationId": {
                "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "activate"
              }
            }
          },
          "then": {
            "required": [
              "applicationId"
            ],
            "properties": {
              "applicationId": {
                "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "quit"
              }
            }
          },
          "then": {
            "required": [
              "applicationId"
            ],
            "properties": {
              "applicationId": {
                "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "click",
                  "double-click"
                ]
              }
            }
          },
          "then": {
            "required": [
              "target"
            ],
            "properties": {
              "target": {
                "$ref": "#/$defs/target"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "mouse-move"
              }
            }
          },
          "then": {
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "wheel"
              }
            }
          },
          "then": {
            "required": [
              "deltaX",
              "deltaY"
            ],
            "properties": {
              "deltaX": {
                "type": "number"
              },
              "deltaY": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "drag"
              }
            }
          },
          "then": {
            "required": [
              "source",
              "target"
            ],
            "properties": {
              "source": {
                "$ref": "#/$defs/target"
              },
              "target": {
                "$ref": "#/$defs/target"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "type"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "press"
              }
            }
          },
          "then": {
            "required": [
              "key"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "hotkey"
              }
            }
          },
          "then": {
            "required": [
              "keys"
            ],
            "properties": {
              "keys": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "wait"
              }
            }
          },
          "then": {
            "required": [
              "milliseconds"
            ],
            "properties": {
              "milliseconds": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3600000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "screenshot"
              }
            }
          },
          "then": {
            "required": [
              "outputPath"
            ],
            "properties": {
              "outputPath": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
