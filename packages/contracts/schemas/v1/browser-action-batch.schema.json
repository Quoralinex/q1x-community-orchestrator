{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:q1x:community:contracts:v1:browser-action-batch",
  "title": "Browser Action Batch",
  "type": "object",
  "required": [
    "contractVersion",
    "id",
    "actions"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "stopOnError": {
      "type": "boolean"
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 50,
      "maximum": 3600000
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "target": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "by",
            "value"
          ],
          "properties": {
            "by": {
              "const": "selector"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "by",
            "value"
          ],
          "properties": {
            "by": {
              "const": "text"
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "exact": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "by",
            "role"
          ],
          "properties": {
            "by": {
              "const": "role"
            },
            "role": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string"
            },
            "exact": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "by",
            "value"
          ],
          "properties": {
            "by": {
              "const": "label"
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "exact": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "by",
            "value"
          ],
          "properties": {
            "by": {
              "const": "placeholder"
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "exact": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "action": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "navigate",
            "back",
            "forward",
            "reload",
            "inspect",
            "extract",
            "click",
            "double-click",
            "hover",
            "fill",
            "type",
            "press",
            "select",
            "check",
            "uncheck",
            "mouse-move",
            "mouse-down",
            "mouse-up",
            "wheel",
            "drag",
            "wait",
            "upload",
            "download",
            "screenshot"
          ]
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "source": {
          "$ref": "#/$defs/target"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "text": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "deltaX": {
          "type": "number"
        },
        "deltaY": {
          "type": "number"
        },
        "button": {
          "enum": [
            "left",
            "middle",
            "right"
          ]
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outputPath": {
          "type": "string",
          "minLength": 1
        },
        "extract": {
          "enum": [
            "text",
            "html",
            "attribute"
          ]
        },
        "attribute": {
          "type": "string",
          "minLength": 1
        },
        "fullPage": {
          "type": "boolean"
        },
        "milliseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 50,
          "maximum": 3600000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "navigate"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "id",
              "kind",
              "url"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "click"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "id",
              "kind",
              "target"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "double-click"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "id",
              "kind",
              "target"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "hover"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "id",
              "kind",
              "target"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "fill"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "id",
              "kind",
              "target",
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "type"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "id",
              "kind",
              "target",
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "press"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "id",
              "kind",
              "target",
              "key"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "select"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "id",
              "kind",
              "target",
              "values"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "check"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "id",
              "kind",
              "target"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "uncheck"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "id",
              "kind",
              "target"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "upload"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "id",
              "kind",
              "target",
              "paths"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "download"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "id",
              "kind",
              "target",
              "outputPath"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "mouse-move"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "id",
              "kind",
              "x",
              "y"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "mouse-down"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "id",
              "kind"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "mouse-up"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "id",
              "kind"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "wheel"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "id",
              "kind",
              "deltaX",
              "deltaY"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "drag"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "id",
              "kind",
              "source",
              "target"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "wait"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "id",
              "kind"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "screenshot"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "id",
              "kind",
              "outputPath"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "back"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "id",
              "kind"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "forward"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "id",
              "kind"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "reload"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "id",
              "kind"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "inspect"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "id",
              "kind"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "extract"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "id",
              "kind"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "extract": {
                "const": "attribute"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "attribute"
            ]
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
