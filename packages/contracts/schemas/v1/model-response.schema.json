{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:q1x:community:contracts:v1:model-response",
  "title": "Model Response",
  "type": "object",
  "required": [
    "contractVersion",
    "id",
    "requestId",
    "endpointId",
    "outputText",
    "startedAt",
    "finishedAt"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier"
    },
    "requestId": {
      "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier"
    },
    "endpointId": {
      "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier"
    },
    "outputText": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "usage": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "finishReason": {
      "type": "string"
    },
    "startedAt": {
      "$ref": "urn:q1x:community:contracts:v1:common#/$defs/timestamp"
    },
    "finishedAt": {
      "$ref": "urn:q1x:community:contracts:v1:common#/$defs/timestamp"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
