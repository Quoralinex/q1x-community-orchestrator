{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:q1x:community:contracts:v1:model-request",
  "title": "Model Request",
  "type": "object",
  "required": [
    "contractVersion",
    "id",
    "endpointId",
    "messages",
    "createdAt"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier"
    },
    "endpointId": {
      "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "maxOutputTokens": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "$ref": "urn:q1x:community:contracts:v1:common#/$defs/timestamp"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
