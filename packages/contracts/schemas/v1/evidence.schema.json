{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:q1x:community:contracts:v1:evidence",
  "title": "Evidence",
  "type": "object",
  "required": ["contractVersion", "id", "kind", "summary", "collectedAt"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "id": { "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier" },
    "kind": { "enum": ["source", "observation", "test-result", "simulation-result", "review", "measurement", "citation", "other"] },
    "summary": { "type": "string", "minLength": 1 },
    "sourceUri": { "type": "string", "format": "uri" },
    "artifactRef": { "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier" },
    "executionRef": { "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier" },
    "resultRef": { "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier" },
    "contentDigest": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "enum": ["sha256", "sha512"] },
        "value": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "algorithm": { "const": "sha256" } }, "required": ["algorithm"] },
          "then": { "properties": { "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } }
        },
        {
          "if": { "properties": { "algorithm": { "const": "sha512" } }, "required": ["algorithm"] },
          "then": { "properties": { "value": { "type": "string", "pattern": "^[0-9a-f]{128}$" } } }
        }
      ],
      "additionalProperties": false
    },
    "claims": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "provenance": {
      "type": "object",
      "properties": {
        "actor": { "$ref": "urn:q1x:community:contracts:v1:common#/$defs/actor" },
        "method": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "collectedAt": { "$ref": "urn:q1x:community:contracts:v1:common#/$defs/timestamp" }
  },
  "additionalProperties": false
}
