{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:q1x:community:contracts:v1:evidence",
  "title": "Evidence",
  "type": "object",
  "required": [
    "contractVersion",
    "id",
    "kind",
    "summary",
    "collectedAt"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier"
    },
    "kind": {
      "enum": [
        "source",
        "observation",
        "test-result",
        "simulation-result",
        "review",
        "measurement",
        "citation",
        "other"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "sourceUri": {
      "type": "string",
      "format": "uri"
    },
    "artifactRef": {
      "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "actor": {
          "$ref": "urn:q1x:community:contracts:v1:common#/$defs/actor"
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "collectedAt": {
      "$ref": "urn:q1x:community:contracts:v1:common#/$defs/timestamp"
    }
  },
  "additionalProperties": false
}
