{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:q1x:community:contracts:v1:execution-request",
  "title": "Execution Request",
  "type": "object",
  "required": [
    "contractVersion",
    "id",
    "workItemId",
    "requirements",
    "input",
    "createdAt"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier"
    },
    "workItemId": {
      "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier"
    },
    "requirements": {
      "type": "object",
      "required": [
        "operations"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "adapterKinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:q1x:community:contracts:v1:common#/$defs/adapterKind"
          }
        },
        "inputModalities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:q1x:community:contracts:v1:common#/$defs/modality"
          }
        },
        "outputModalities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:q1x:community:contracts:v1:common#/$defs/modality"
          }
        },
        "localOnly": {
          "type": "boolean"
        },
        "minimumTrust": {
          "$ref": "urn:q1x:community:contracts:v1:common#/$defs/trustLevel"
        }
      },
      "additionalProperties": false
    },
    "input": {},
    "contextRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:q1x:community:contracts:v1:common#/$defs/reference"
      }
    },
    "policy": {
      "type": "object",
      "properties": {
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "maxCost": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "privacy": {
          "$ref": "urn:q1x:community:contracts:v1:common#/$defs/privacyLevel"
        }
      },
      "additionalProperties": false
    },
    "createdAt": {
      "$ref": "urn:q1x:community:contracts:v1:common#/$defs/timestamp"
    }
  },
  "additionalProperties": false
}
