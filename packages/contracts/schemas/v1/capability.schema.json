{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:q1x:community:contracts:v1:capability",
  "title": "Capability Descriptor",
  "type": "object",
  "required": [
    "contractVersion",
    "id",
    "name",
    "adapterKind",
    "operations",
    "modalities",
    "availability",
    "cost",
    "privacy",
    "trust",
    "platforms"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "adapterKind": {
      "$ref": "urn:q1x:community:contracts:v1:common#/$defs/adapterKind"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "modalities": {
      "type": "object",
      "required": [
        "input",
        "output"
      ],
      "properties": {
        "input": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:q1x:community:contracts:v1:common#/$defs/modality"
          }
        },
        "output": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:q1x:community:contracts:v1:common#/$defs/modality"
          }
        }
      },
      "additionalProperties": false
    },
    "availability": {
      "type": "object",
      "required": [
        "state",
        "checkedAt"
      ],
      "properties": {
        "state": {
          "$ref": "urn:q1x:community:contracts:v1:common#/$defs/availabilityState"
        },
        "checkedAt": {
          "$ref": "urn:q1x:community:contracts:v1:common#/$defs/timestamp"
        },
        "detail": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "cost": {
      "type": "object",
      "required": [
        "class"
      ],
      "properties": {
        "class": {
          "$ref": "urn:q1x:community:contracts:v1:common#/$defs/costClass"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "unitCost": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "required": [
        "executionLocation"
      ],
      "properties": {
        "executionLocation": {
          "$ref": "urn:q1x:community:contracts:v1:common#/$defs/privacyLevel"
        },
        "dataRetention": {
          "enum": [
            "none",
            "session",
            "provider-policy",
            "configurable",
            "unknown"
          ]
        }
      },
      "additionalProperties": false
    },
    "trust": {
      "type": "object",
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "$ref": "urn:q1x:community:contracts:v1:common#/$defs/trustLevel"
        },
        "validatedAt": {
          "$ref": "urn:q1x:community:contracts:v1:common#/$defs/timestamp"
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:q1x:community:contracts:v1:common#/$defs/platform"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
