{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:q1x:community:contracts:v1:programme",
  "title": "Programme",
  "type": "object",
  "required": [
    "contractVersion",
    "id",
    "missionId",
    "revision",
    "status",
    "workstreams",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier"
    },
    "missionId": {
      "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "planned",
        "active",
        "paused",
        "completed",
        "cancelled"
      ]
    },
    "workstreams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "objective",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "planned",
              "active",
              "blocked",
              "completed",
              "cancelled"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "createdAt": {
      "$ref": "urn:q1x:community:contracts:v1:common#/$defs/timestamp"
    },
    "updatedAt": {
      "$ref": "urn:q1x:community:contracts:v1:common#/$defs/timestamp"
    }
  },
  "additionalProperties": false
}
