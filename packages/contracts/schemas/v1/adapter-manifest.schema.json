{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:q1x:community:contracts:v1:adapter-manifest",
  "title": "Adapter Manifest",
  "type": "object",
  "required": [
    "contractVersion",
    "id",
    "name",
    "version",
    "adapterKind",
    "platforms",
    "capabilityIds"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "adapterKind": {
      "$ref": "urn:q1x:community:contracts:v1:common#/$defs/adapterKind"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:q1x:community:contracts:v1:common#/$defs/platform"
      }
    },
    "capabilityIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:q1x:community:contracts:v1:common#/$defs/identifier"
      }
    },
    "transport": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "endpointTemplate": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "configurationKeys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
