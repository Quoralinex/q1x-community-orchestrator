    "./linux": {
      "types": "./dist/linux.d.ts",
      "import": "./dist/linux.js"
    }
  },
  "dependencies": {
    "@quoralinex/q1x-community-desktop-bridge-common": "1.0.0-rc.1",
    "@quoralinex/q1x-community-sdk": "1.0.0-rc.1"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/Quoralinex/q1x-community-orchestrator.git",
    "directory": "packages/desktop-bridge-linux"
  },
  "homepage": "https://quoralinex.github.io/q1x-community-orchestrator/",
  "publishConfig": {
    "access": "public"
  }
}
