{
  "name": "@quoralinex/q1x-community-desktop-bridge-linux",
  "version": "1.0.0-rc.1",
  "description": "First-party Linux AT-SPI desktop bridge for Q1X Community Orchestrator.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "bridge"
  ],
  "bin": {
    "q1x-desktop-bridge-linux": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
