# Q1X Community Orchestrator runtime configuration
# Copy values into your process/container environment. Do not put secrets here.

# Persistent runtime home. Defaults to ~/.q1x-community-orchestrator outside containers.
Q1X_HOME=/data

# Health/readiness service binding. Defaults to 127.0.0.1:8787 for direct local use.
Q1X_HOST=127.0.0.1
Q1X_PORT=8787
